# ============================================================
# AuraRing Landing Page — HELICORP
# Environment Variables Template
# ============================================================
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.
# ============================================================

# --- App Base URL (used for Open Graph metadata) ---
# Set to your deployed domain on Vercel
NEXT_PUBLIC_BASE_URL=https://helicorp-landing.vercel.app

# --- Chatbot AI (Gemini) ---
# Get your key at: https://console.cloud.google.com/
# Create a Google Cloud API key with Generative AI / Gemini enabled.
# If not set, the chatbot falls back to keyword-based responses.
GEMINI_API_KEY=your_gemini_api_key_here

# --- Newsletter Webhook ---
# Optional: POST endpoint to receive newsletter signups
# Example: n8n, Zapier, Make.com, or your own backend
# If not set, signups are only logged to the server console.
NEWSLETTER_WEBHOOK_URL=https://your-webhook-url.example.com/newsletter
