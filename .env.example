# ============================================================
# AuraRing Landing Page — HELICORP
# Environment Variables Template
# ============================================================
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.
# ============================================================

# --- App Base URL (used for Open Graph metadata) ---
# Set to your deployed domain on Vercel
NEXT_PUBLIC_BASE_URL=https://helicorp-landing.vercel.app

# --- Chatbot AI (Gemini) ---
# Get your key at: https://console.cloud.google.com/
# Create a Google Cloud API key with Generative AI / Gemini enabled.
# Use a supported Gemini model for the API, for example gemini-flash-latest.
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override the default Gemini model if needed
# GEMINI_MODEL=gemini-flash-latest

# --- Resend Email ---
# Get your API key at: https://resend.com
# Verify your sending domain in Resend and set your owner email address.
# If you use an unverified default from address, Resend may only allow sending to your account email.
# Example: FROM_EMAIL=hello@yourdomain.com
RESEND_API_KEY=your_resend_api_key_here
OWNER_EMAIL=owner@example.com
# Optional: override the default from address
# FROM_EMAIL=AuraRing <hello@yourdomain.com>

# --- Newsletter Webhook ---
# Optional: POST endpoint to receive newsletter signups
# Example: n8n, Zapier, Make.com, or your own backend
# If not set, signups are only logged to the server console.
NEWSLETTER_WEBHOOK_URL=https://your-webhook-url.example.com/newsletter
